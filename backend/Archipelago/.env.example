# Set a strong initial demo password. Existing users are never overwritten.
WORLD_DEMO_USERNAME=demo
WORLD_DEMO_PASSWORD=
WORLD_AUTH_ISSUER=http://localhost:8080
WORLD_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
WORLD_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
WORLD_AUTH_ALLOWED_ORIGIN=http://localhost:5173
WORLD_AUTH_KEY_PATH=./data/signing-key.json
WORLD_DATABASE_PATH=./data/world.db
NACOS_ENABLED=false
NACOS_SERVER_ADDR=localhost:8848
# Namespace ID (empty selects public), config group and optional Nacos credentials.
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_TIMEOUT=3000
WORLD_STORAGE_ENABLED=false
WORLD_STORAGE_ENDPOINT=
WORLD_STORAGE_PUBLIC_ENDPOINT=
WORLD_STORAGE_ACCESS_KEY=
WORLD_STORAGE_SECRET_KEY=
WORLD_STORAGE_BUCKET=
WORLD_STORAGE_REGION=us-east-1
WORLD_STORAGE_MAX_FILE_BYTES=20971520
WORLD_STORAGE_UPLOAD_TTL=5m
WORLD_STORAGE_DOWNLOAD_TTL=15m
SERVER_PORT=8080

# ============================================================
#  services/ 部署环境变量模板
#
#  用法：
#    cp .env.example .env   然后按下方说明填写
#    改完 .env 后必须执行：docker compose up -d
#    （docker compose restart 不会重载环境变量，这是最常见的坑）
# ============================================================


# ------------------------------------------------------------
# 1. 模式开关（决定用真证书还是自签名）
# ------------------------------------------------------------
# true  = 有域名：letsencrypt 先用阿里云 DNS 申请真证书，nginx 加载真证书
# false = 无域名：全套降级为 IP + 自签名证书，nginx 照常启动（不会卡住）
#
# 从 true 改成 false（或反过来）后，执行 docker compose up -d 即可切换。
# 两种模式共用同一个证书卷，互不污染，可反复切换。
HAS_DOMAIN=true

# nginx server_name。
#   有域名：填域名，如 lovedage.com.cn
#   无域名：填 _ （单个下划线，表示"任意主机名"）
SERVER_NAME=lovedage.com.cn

# 对外访问根地址。下面所有 OIDC 地址都由它派生，降级时只改这一处。
#   有域名：https://lovedage.com.cn
#   无域名：http://192.168.1.10   （换成你服务器的实际 IP）
PUBLIC_ORIGIN=https://lovedage.com.cn


# ------------------------------------------------------------
# 2. 证书
# ------------------------------------------------------------
# 申请证书的域名，多个用空格分隔。通配符走 DNS-01 验证（本方案已用该方式）。
DOMAIN=*.lovedage.com.cn

# 证书目录名。留空则自动取 DOMAIN 去掉通配符前缀（*.a.com -> a.com）。
# 一旦定下不要随意改：改了等于换一套证书目录，certbot 会重新签发。
CERT_NAME=

# Certbot 注册邮箱（证书到期提醒）
EMAIL=

# 阿里云 DNS API 凭据。建议用 RAM 子账号，只授予 AliyunDNSFullAccess
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# true 时走 Let's Encrypt 测试环境：不消耗签发配额，但证书浏览器不信任，仅调试用
USE_TEST_ENV=false

# 证书签发/续订成功后，把证书内容 POST 到该地址。留空则跳过这个 hook。
# 注意：若填写后又不想用了，改回空值并重建 letsencrypt 容器即可
#（certbot 会把 hook 记进 renewal 配置，脚本已做条件判断，留空不会再执行）
WEBHOOK_URL=
# 配合 WEBHOOK_URL 的 AES 加密密钥（可选，留空则明文传输）
ENCRYPT_KEY=

# 有域名模式下，cert-init 等待证书签发的上限秒数。超时则降级为自签名并告警，
# 保证 nginx 一定能起来。DNS-01 通常 30 秒 ~ 3 分钟，5 分钟足够。
CERT_WAIT_TIMEOUT=300


# ------------------------------------------------------------
# 3. 端口（对外暴露）
# ------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# RustFS 的对外入口，nginx 反代到 rustfs:9000，供浏览器直接取图
STORAGE_PORT=8444
# 后端直连端口，调试用（正式访问走 nginx 的 443）
BACKEND_PORT=8080


# ------------------------------------------------------------
# 4. 时区
# ------------------------------------------------------------
# certbot 的续订任务写在 crond 的 02:00，容器不设时区的话实际是北京时间 10:00
TZ=Asia/Shanghai


# ------------------------------------------------------------
# 5. RustFS 对象存储
# ------------------------------------------------------------
# 注意：这两个值会同时喂给 rustfs 容器和 backend 的 WORLD_STORAGE_*，
# 不需要在两处分别维护。请勿使用官方文档点名的弱口令 rustfsadmin。
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=


# ------------------------------------------------------------
# 6. 后端（Archipelago）
# ------------------------------------------------------------
# 演示账号。仅在数据库首次创建时生效，之后改这里不会重设已有账号密码。
# 注意：数据库还没有该用户时，密码留空会让后端启动失败
#（报错 WORLD_DEMO_PASSWORD is required to initialize the demo user），首次部署必须设置。
WORLD_DEMO_USERNAME=demo
WORLD_DEMO_PASSWORD=

# 存储桶名（需预先存在，本服务不会自动创建）
WORLD_STORAGE_BUCKET=prod-world-storage
WORLD_STORAGE_REGION=us-east-1

# 浏览器可达的存储地址——前端用它直取图片，必须是公网能解析到的地址。
# 由 nginx 的 STORAGE_PORT 反代提供，所以通常就是：
#   https://api.<你的域名>:${STORAGE_PORT}
# 无域名时填成 http://<服务器IP>:${STORAGE_PORT}（注意浏览器会因混合内容拦 http）
WORLD_STORAGE_PUBLIC_ENDPOINT=https://api.lovedage.com.cn:8444

# Nacos 配置中心：默认关闭
NACOS_ENABLED=false

# 以下变量由 compose 自动派生，不用在这里写：
#   WORLD_AUTH_ISSUER / WORLD_AUTH_REDIRECT_URI
#   WORLD_AUTH_POST_LOGOUT_REDIRECT_URI / WORLD_AUTH_ALLOWED_ORIGIN   <- 派生自 PUBLIC_ORIGIN
#   WORLD_STORAGE_ACCESS_KEY / WORLD_STORAGE_SECRET_KEY               <- 取自 RUSTFS_ACCESS_KEY/SECRET_KEY
#   WORLD_STORAGE_ENDPOINT                                            <- 固定为内网 http://rustfs:9000
#   WORLD_DATABASE_PATH / WORLD_AUTH_KEY_PATH                         <- 固定为容器内 /app/data/

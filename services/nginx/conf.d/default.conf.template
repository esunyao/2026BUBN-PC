# ============================================================
#  nginx 站点配置（envsubst 模板）
#
#  容器启动时由 nginx 官方镜像的 20-envsubst-on-templates.sh 处理：
#    /etc/nginx/templates/default.conf.template  ->  /etc/nginx/conf.d/default.conf
#
#  只有 ${SERVER_NAME} 会被替换（环境变量 NGINX_ENVSUBST_FILTER 已限定），
#  $host / $request_uri 等 nginx 运行时变量原样保留。
#
#  证书路径写死为 active/ 指针，不区分模式：
#    cert-init 保证它一定存在——有域名时指向 certbot 签发的真证书，
#    无域名时指向自签名证书。
# ============================================================


# ------------------------------------------------------------
# 80：全部重定向到 HTTPS
#（证书用 DNS-01 验证，不需要在 80 端口暴露 acme-challenge）
# ------------------------------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name ${SERVER_NAME};

    return 301 https://$host$request_uri;
}


# ------------------------------------------------------------
# 443：后端 API 与 OIDC 端点
# ------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/active/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/active/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 传给后端的真实来源信息。
    # 后端侧需配合 SERVER_FORWARD_HEADERS_STRATEGY=FRAMEWORK
    #（在 docker-compose.yaml 里已设置），否则 OIDC 生成的绝对链接会指向 http。
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;

    # 根路径暂无前端产物（前端本轮不容器化）。
    # 将来要由 nginx 托管前端时，取消下面这段注释，
    # 并在 docker-compose.yaml 的 nginx 服务里挂载 ../frontend/dist：
    #
    #   - ../frontend/dist:/usr/share/nginx/html:ro
    #
    # location / {
    #     root /usr/share/nginx/html;
    #     try_files $uri $uri/ /index.html;
    # }

    # 根路径精确匹配 -> 404；其余路径全部交给后端。
    # 之所以不逐个列出 /api/、/oauth2/、/.well-known/ 等，
    # 是因为 OIDC 端点较多，逐个列举一旦遗漏就会静默中断登录流程。
    location = / {
        return 404;
    }

    location / {
        proxy_pass http://backend:8080;
    }
}


# ------------------------------------------------------------
# 8444：RustFS（对象存储对外入口）
#
# 浏览器用它直取图片（预签名 URL 的 domain 就是这里），
# 所以必须与实际签名的地址完全一致——协议、域名、端口、路径都不能变。
# 后端自身走内网 http://rustfs:9000，不经过这里。
#
# 注意：证书必须覆盖此地址的主机名（如 api.<域名>）。
#      用通配符证书 *.lovedage.com.cn 即可一并覆盖。
# ------------------------------------------------------------
server {
    listen      8444 ssl;
    listen      [::]:8444 ssl;
    http2       on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/active/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/active/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 图片上传/下载不限制体积与时长
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://rustfs:9000;

        # S3 的预签名校验把 Host 算进签名，
        # 必须透传原始 Host（含端口），改写会导致 SignatureDoesNotMatch。
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 让 CORS 预检与响应头正常透传给浏览器
        proxy_pass_request_headers on;
    }
}
